{
  "name": "project-git-pull",
  "displayName": "Project Git Pull",
  "description": "Automatically pull the latest changes from the remote repository for the current project in VS Code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "extensionDependencies": ["vscode.git"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "project-git-pull.syncNow",
        "title": "Project Git Pull: Sync Now"
      }
    ],
    "configuration": {
      "title": "Project Git Pull",
      "properties": {
        "projectGitPull.branch": {
          "type": "string",
          "default": "develop",
          "description": "The team's main branch that should be kept up to date."
        },
        "projectGitPull.mode": {
          "type": "string",
          "enum": ["ask", "auto"],
          "default": "ask",
          "description": "'ask' shows a notification before pulling, 'auto' pulls without asking (only when there are no uncommitted changes)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.145.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
